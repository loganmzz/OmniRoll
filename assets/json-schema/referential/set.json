{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loganmzz.github.io/OmniRoll/schemas/referential/set.json",
  "title": "Boardgame Universal Randomizer - Referential | Module",
  "type": "object",
  "required": [
    "key",
    "name"
  ],
  "properties": {
    "key": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "features": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sets": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "$ref": "set.json"
          },
          {
            "$ref": "include.json"
          }
        ]
      }
    },
    "components": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "component.json"
        }
      }
    }
  }
}
